<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">
  <persistence-unit name="IronCryptPU" transaction-type="JTA">
    <jta-data-source>jdbc/ironcrypt</jta-data-source>
    <class>com.ironcrypt.modelo.entidades.Usuario</class>
    <class>com.ironcrypt.modelo.entidades.Equipo</class>
    <class>com.ironcrypt.modelo.entidades.MiembroEquipo</class>
    <class>com.ironcrypt.modelo.entidades.Boveda</class>
    <class>com.ironcrypt.modelo.entidades.ItemBoveda</class>
    <exclude-unlisted-classes>false</exclude-unlisted-classes>
    <properties>
      <property name="eclipselink.logging.level" value="FINE"/>
      <property name="eclipselink.target-database" value="PostgreSQL"/>
    </properties>
  </persistence-unit>
</persistence>
